# Copier vers .env et adapter.
# Dev : SQLite local. Prod : Postgres (changer aussi provider dans prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions. Générer avec: openssl rand -base64 32
SESSION_SECRET="change-me-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# IA (assistant scolaire). Laisser OPENAI_API_KEY vide désactive proprement
# l'IA : le reste d'Orbs continue de fonctionner.
# ---------------------------------------------------------------------------
# Clé API OpenAI (SECRÈTE — jamais dans le code ni dans le navigateur).
OPENAI_API_KEY=""
# Modèle utilisé. Changer ce seul champ suffit pour changer de modèle.
OPENAI_MODEL="gpt-5.6-terra"
# Optionnels (valeurs par défaut raisonnables si absents) :
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_REASONING_EFFORT="low"        # none|low|medium|high|xhigh|max
# OPENAI_MAX_COMPLETION_TOKENS="1400"  # longueur max de la réponse (défaut du code)
# AI_MAX_MESSAGE_CHARS="4000"          # taille max d'un message
# AI_MAX_CONTEXT_CHARS="6000"          # taille max du contexte scolaire
# AI_MAX_HISTORY_MESSAGES="10"         # messages d'historique envoyés
# AI_TIMEOUT_MS="30000"                # délai d'attente max
# AI_RATE_MAX_PER_MIN="12"             # requêtes/minute par utilisateur
# AI_RATE_MAX_PER_DAY="300"            # requêtes/jour par utilisateur
# --- Assistant vocal (l'élève parle, l'IA répond à voix haute) ---------------
# Utilise la MÊME clé OPENAI_API_KEY (elle doit avoir accès à l'audio).
# OPENAI_STT_MODEL="whisper-1"         # voix → texte (détecte FR/EN seul)
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"   # texte → voix (bilingue)
# AI_MAX_AUDIO_BYTES="4194304"         # taille max d'un extrait audio (octets)
# AI_MAX_SPEAK_CHARS="4000"            # longueur max d'un texte lu à voix haute

# ---------------------------------------------------------------------------
# E-mail (codes de connexion / vérification / mot de passe oublié).
# Sans BREVO_API_KEY, l'app continue de fonctionner : en DÉVELOPPEMENT les
# codes s'affichent dans la console du serveur (flux testable sans rien
# installer) ; en PRODUCTION l'envoi échoue proprement. Voir le README,
# section « Connexion par e-mail ».
# ---------------------------------------------------------------------------
# Service transactionnel : Brevo (https://www.brevo.com). Clé API — SECRÈTE,
# côté serveur uniquement, jamais dans le navigateur ni dans Git.
BREVO_API_KEY=""
# Expéditeur affiché. DOIT être un expéditeur VÉRIFIÉ chez Brevo.
MAIL_FROM_EMAIL="orbs.support@gmail.com"
MAIL_FROM_NAME="Orbs"
# Optionnels (valeurs par défaut raisonnables si absents) :
# MAIL_PROVIDER="brevo"                   # seul fournisseur géré pour l'instant
# MAIL_REPLY_TO="orbs.support@gmail.com"  # si envoi depuis un domaine dédié
# APP_NAME="Orbs"                         # nom affiché dans les e-mails
