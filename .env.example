# Copier vers .env et adapter.
# Dev : SQLite local. Prod : Postgres (changer aussi provider dans prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions. Générer avec: openssl rand -base64 32
SESSION_SECRET="change-me-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# IA (assistant scolaire). Laisser OPENAI_API_KEY vide désactive proprement
# l'IA : le reste d'Orbs continue de fonctionner.
# ---------------------------------------------------------------------------
# Clé API OpenAI (SECRÈTE — jamais dans le code ni dans le navigateur).
OPENAI_API_KEY=""
# Modèle par défaut (sert de repli à Terra et aux cartes de révision).
OPENAI_MODEL="gpt-5.6-terra"
# --- Modes de réflexion (Luna = moyen, Terra = poussé) -----------------------
# Deux modes sélectionnables dans le chat, une seule conversation. Chaque mode
# a son modèle et son effort de raisonnement ; tout le reste est commun.
#   Luna  : tâches quotidiennes / questions courantes (défaut + mode vocal).
#   Terra : problèmes complexes / analyse approfondie.
# Centralisé dans lib/ai/config.ts (resolveMode). Renseigner OPENAI_MODEL_LUNA
# selon le nom exact du modèle « moyen » chez votre fournisseur.
# OPENAI_MODEL_LUNA="gpt-5.6-luna"       # modèle du mode Luna (moyen)
# OPENAI_MODEL_TERRA="gpt-5.6-terra"     # modèle du mode Terra (repli: OPENAI_MODEL)
# OPENAI_REASONING_EFFORT_LUNA="medium"  # none|low|medium|high|xhigh|max
# OPENAI_REASONING_EFFORT_TERRA="high"   # none|low|medium|high|xhigh|max
# Optionnels (valeurs par défaut raisonnables si absents) :
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_REASONING_EFFORT="low"        # effort par défaut (repli de Terra)
# OPENAI_MAX_COMPLETION_TOKENS="1400"  # longueur max de la réponse (défaut du code)
# AI_MAX_MESSAGE_CHARS="4000"          # taille max d'un message
# AI_MAX_CONTEXT_CHARS="6000"          # taille max du contexte scolaire
# AI_MAX_HISTORY_MESSAGES="10"         # messages d'historique envoyés
# AI_TIMEOUT_MS="30000"                # délai d'attente max
# AI_RATE_MAX_PER_MIN="12"             # requêtes/minute par utilisateur
# AI_RATE_MAX_PER_DAY="300"            # requêtes/jour par utilisateur
# --- Assistant vocal (l'élève parle, l'IA répond à voix haute) ---------------
# Utilise la MÊME clé OPENAI_API_KEY (elle doit avoir accès à l'audio).
# OPENAI_STT_MODEL="whisper-1"         # voix → texte (détecte FR/EN seul)
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"   # texte → voix (bilingue)
# AI_MAX_AUDIO_BYTES="4194304"         # taille max d'un extrait audio (octets)
# AI_MAX_SPEAK_CHARS="4000"            # longueur max d'un texte lu à voix haute

# ---------------------------------------------------------------------------
# E-mail (codes de connexion / vérification / mot de passe oublié).
# Sans BREVO_API_KEY, l'app continue de fonctionner : en DÉVELOPPEMENT les
# codes s'affichent dans la console du serveur (flux testable sans rien
# installer) ; en PRODUCTION l'envoi échoue proprement. Voir le README,
# section « Connexion par e-mail ».
# ---------------------------------------------------------------------------
# Service transactionnel : Brevo (https://www.brevo.com). Clé API — SECRÈTE,
# côté serveur uniquement, jamais dans le navigateur ni dans Git.
BREVO_API_KEY=""
# Expéditeur affiché. DOIT être un expéditeur VÉRIFIÉ chez Brevo.
MAIL_FROM_EMAIL="orbs.support@gmail.com"
MAIL_FROM_NAME="Orbs"
# Optionnels (valeurs par défaut raisonnables si absents) :
# MAIL_PROVIDER="brevo"                   # seul fournisseur géré pour l'instant
# MAIL_REPLY_TO="orbs.support@gmail.com"  # si envoi depuis un domaine dédié
# APP_NAME="Orbs"                         # nom affiché dans les e-mails

# ---------------------------------------------------------------------------
# Abonnements (Orbs Plus / Ultimate) + crédits IA + paiements Stripe.
# Sans STRIPE_SECRET_KEY, l'app fonctionne : en DÉVELOPPEMENT les abonnements
# sont SIMULÉS (aucune vraie transaction, tout le parcours reste testable) ;
# en PRODUCTION la souscription échoue proprement. Voir docs/abonnements.md
# pour la configuration externe et les étapes de validation humaine.
# ---------------------------------------------------------------------------
# Clés Stripe — SECRÈTES, côté serveur uniquement, jamais dans le navigateur.
STRIPE_SECRET_KEY=""        # sk_test_… (dev) ou sk_live_… (prod)
STRIPE_WEBHOOK_SECRET=""    # whsec_… (vérification de signature des webhooks)
# Identifiants de Price récurrents créés dans le Dashboard Stripe (NON secrets).
STRIPE_PRICE_PLUS=""        # price_… (Orbs Plus, 12,99 €/mois)
STRIPE_PRICE_ULTIMATE=""    # price_… (Orbs Ultimate, 21,99 €/mois)
# Optionnels :
# STRIPE_API_VERSION=""     # épingler une version d'API Stripe (sinon défaut du compte)
# APP_BASE_URL="https://orbs.example.com"  # base des URLs de retour Stripe (sinon déduit des en-têtes)

# --- Prix affichés (DOIVENT correspondre aux Price réels dans Stripe) --------
# SUBSCRIPTION_PLUS_PRICE_EUR="12.99"
# SUBSCRIPTION_ULTIMATE_PRICE_EUR="21.99"

# --- Allocations mensuelles de crédits (configurables) -----------------------
# Dérivées d'une marge saine face au coût API maximal (voir lib/billing/pricing.ts
# et docs/abonnements.md). Le portefeuille est UNIQUE (Core + Ultra + voix + fiches).
# Il N'Y A PAS d'offre gratuite : sans abonnement actif = 0 crédit (aucune
# allocation automatique). Les crédits ne viennent que des offres payantes.
# CREDITS_MONTHLY_PLUS="2500"
# CREDITS_MONTHLY_ULTIMATE="5000"
# Durée de vie d'une réservation de crédits avant libération auto (ms, défaut 5 min).
# CREDITS_RESERVATION_TTL_MS="300000"

# --- Économie de crédits (dérivée des COÛTS API RÉELS, configurable) ---------
# Valeur d'un crédit = coût API (en €) qu'il couvre. 0,002 € ⇒ 500 crédits/€ d'API.
# CREDITS_VALUE_EUR="0.002"
# Prix des modèles (€/million de tokens) — Core (effort moyen) / Ultra (poussé).
# CREDITS_CORE_INPUT_EUR_PER_MTOK="0.25"
# CREDITS_CORE_OUTPUT_EUR_PER_MTOK="2.0"
# CREDITS_ULTRA_INPUT_EUR_PER_MTOK="1.25"
# CREDITS_ULTRA_OUTPUT_EUR_PER_MTOK="10.0"
# Consommation moyenne estimée par action (tokens) + coût forfaitaire voix (€) :
# CREDITS_USAGE_CHAT_CORE_IN="1500"   CREDITS_USAGE_CHAT_CORE_OUT="600"
# CREDITS_USAGE_CHAT_ULTRA_IN="1800"  CREDITS_USAGE_CHAT_ULTRA_OUT="1400"
# CREDITS_USAGE_CARDS_IN="1600"       CREDITS_USAGE_CARDS_OUT="900"
# CREDITS_VOICE_STT_EUR="0.004"       CREDITS_VOICE_TTS_EUR="0.004"

# --- Débit IA par offre (requêtes / minute et / jour) ------------------------
# RATE_NOSUB_PER_MIN="6"       RATE_NOSUB_PER_DAY="60"   # sans abonnement (bloqué de toute façon)
# RATE_PLUS_PER_MIN="20"       RATE_PLUS_PER_DAY="600"
# RATE_ULTIMATE_PER_MIN="30"   RATE_ULTIMATE_PER_DAY="1200"
