// Orbs — schéma de données du journal.
//
// Base de dev : SQLite (zéro configuration, tourne partout).
// Pour passer en production sur Postgres, il suffit de remplacer
//   provider = "sqlite"  ->  provider = "postgresql"
// et de pointer DATABASE_URL vers l'instance Postgres. Le reste du
// modèle est écrit pour rester compatible (pas d'enum natif, tags en
// relation, listes stockées en JSON string).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified DateTime? // date de vérification de l'e-mail (null = jamais vérifié)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profil / compte
  firstName   String? // prénom
  lastName    String? // nom
  schoolClass String? // classe, ex. « Terminale S »
  school      String? // établissement
  avatar      String? // configuration de l'avatar (JSON)

  // Espace famille
  role              String    @default("student") // "student" | "parent"
  familyCode        String?   @unique // code d'invitation temporaire (élève)
  familyCodeExpires DateTime?
  shareMood         Boolean   @default(false) // l'élève partage son humeur du journal
  learnSnapshot     String? // résumé JSON de la progression Apprendre (synchro locale -> serveur)
  learnSyncedAt     DateTime?

  entries  Entry[]
  tags     Tag[]
  settings Settings?

  children        FamilyLink[] @relation("ParentLinks")
  parents         FamilyLink[] @relation("ChildLinks")
  cheersSent      Cheer[]      @relation("CheerFrom")
  cheersReceived  Cheer[]      @relation("CheerTo")
  challengesSet   Challenge[]  @relation("ChallengeFrom")
  challengesToDo  Challenge[]  @relation("ChallengeTo")

  // Abonnement commercial + portefeuille de crédits IA
  subscription Subscription?
  wallet       CreditWallet?
  ledger       CreditLedger[]
  reservations CreditReservation[]
}

/// Abonnement commercial de l'utilisateur.
///
/// Un SEUL enregistrement par utilisateur (`userId @unique`) : il suit tout le
/// cycle de vie de l'abonnement (création, renouvellement, changement d'offre,
/// annulation, expiration) plutôt que d'empiler des lignes. L'historique fin
/// des mouvements de crédits vit dans `CreditLedger`.
///
/// Pas d'enum natif (compat Postgres ⇄ SQLite) : les valeurs sont des chaînes
/// validées côté code (voir lib/billing/plans.ts).
///
/// - `plan`   : "plus" | "ultimate" (l'offre « muse » est réservée à plus tard,
///              volontairement absente). Repli implicite = pas d'abonnement = « free ».
/// - `status` : cycle de vie Stripe reflété ici —
///              "active"     : abonnement payant en cours ;
///              "trialing"   : période d'essai (si un jour activée) ;
///              "past_due"   : paiement de renouvellement échoué (accès en sursis) ;
///              "canceled"   : résilié mais encore actif jusqu'à la fin de période ;
///              "expired"    : terminé (plus d'accès payant) ;
///              "incomplete" : paiement initial non finalisé.
/// - Les identifiants Stripe ne sont JAMAIS des secrets (ni clé API ni jeton) :
///   ce sont des références opaques côté Stripe.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String // "plus" | "ultimate"
  status String @default("incomplete") // active | trialing | past_due | canceled | expired | incomplete

  // Références Stripe (opaques, non secrètes).
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Cycle de facturation courant (copié depuis Stripe aux webhooks).
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Résiliation : programmée à la fin de la période (l'accès reste jusque-là).
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  // Changement d'offre programmé pour la fin de période (ex. rétrogradation
  // Ultimate → Plus). Appliqué au renouvellement. null = aucun changement.
  scheduledPlan String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Portefeuille UNIQUE de crédits IA de l'utilisateur.
///
/// « Portefeuille unique » : un seul solde (`balance`) sert à TOUTES les
/// consommations d'IA, quel que soit le moteur — Core (réflexion moyenne) ou
/// Ultra (réflexion poussée) — ainsi que la voix et la génération de fiches.
/// Les moteurs ne changent que le COÛT en crédits de chaque action (voir
/// lib/billing/pricing.ts), jamais la source des crédits.
///
/// Modèle « allocation mensuelle » : à chaque cycle de facturation (ou, pour un
/// compte gratuit, chaque mois glissant), le solde est ramené à l'allocation de
/// l'offre. Les crédits non utilisés ne se cumulent pas d'un cycle à l'autre.
model CreditWallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance   Int @default(0) // crédits dépensables maintenant (le portefeuille)
  allowance Int @default(0) // allocation accordée pour le cycle courant (pour la jauge)

  // Début du cycle courant de crédits. Pour un compte gratuit, sert au
  // rafraîchissement « paresseux » mensuel (sans tâche planifiée).
  cycleStart DateTime  @default(now())
  cycleEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger CreditLedger[]
}

/// Journal append-only des mouvements de crédits (audit + affichage conso).
///
/// Chaque ligne = un mouvement : `delta` positif (octroi) ou négatif (dépense),
/// avec le solde résultant (`balanceAfter`) pour reconstituer l'historique sans
/// recalcul. `reason` catégorise le mouvement ; `engine` précise Core/Ultra pour
/// une dépense de chat.
///
/// `cycleKey` : clé d'IDEMPOTENCE des OCTROIS liés à une période. Un octroi de
/// cycle (`grant_cycle`) ou de montée d'offre (`grant_upgrade`) porte une clé
/// déterministe dérivée de l'utilisateur, du type d'octroi et du DÉBUT de
/// période (jamais de l'horloge courante). La contrainte unique
/// `@@unique([userId, cycleKey])` fait de l'INSERTION de la ligne une garde
/// atomique en base : deux webhooks rejoués ou simultanés visant la même période
/// ne peuvent créditer qu'UNE seule fois (le second heurte la contrainte et
/// échoue sans effet). Les mouvements qui ne sont pas des octrois de période
/// (dépenses, expiration, ajustements) laissent `cycleKey` à `null` ; plusieurs
/// `null` coexistent (SQLite comme Postgres traitent les `null` comme distincts
/// dans un index unique), donc la contrainte ne gêne que les octrois.
model CreditLedger {
  id       String       @id @default(cuid())
  walletId String
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String // dénormalisé pour une lecture simple par utilisateur
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  delta        Int // + octroi, - dépense
  balanceAfter Int
  reason       String // grant_signup | grant_cycle | grant_upgrade | spend_chat | spend_cards | spend_voice_stt | spend_voice_tts | expire_cycle | adjust
  engine       String? // "core" | "ultra" | null
  meta         String? // JSON optionnel (modèle, tokens estimés, offre…)
  cycleKey     String? // clé d'idempotence d'octroi par période (null hors octroi)

  createdAt DateTime @default(now())

  @@unique([userId, cycleKey]) // garde atomique : un octroi par (utilisateur, période)
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}

/// Réservation de crédits (crédits « en attente » pendant un appel IA).
///
/// Modèle réserver → réconcilier : avant d'appeler le modèle, on RETIENT une
/// estimation de crédits (le solde du portefeuille est décrémenté d'autant).
/// Une fois la consommation RÉELLE connue (tokens renvoyés par le fournisseur),
/// on débite le coût réel et on REND la différence (voir lib/billing/store.ts →
/// reserve / settle / release). La ligne n'existe QUE tant que la réservation
/// est ouverte : elle est supprimée à la réconciliation (le CreditLedger garde
/// la trace définitive de la consommation). Une réservation orpheline (crash /
/// interruption) est libérée par balayage après expiration (`createdAt`).
model CreditReservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  op        String // chat_core | chat_ultra | cards | voice_stt | voice_tts
  engine    String? // core | ultra | null
  estimated Int // crédits retenus sur le solde
  meta      String? // JSON optionnel (modèle, estimation…)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Idempotence des webhooks Stripe : on mémorise les `event.id` déjà traités
/// pour ne jamais rejouer un événement (Stripe peut livrer plusieurs fois).
model ProcessedWebhookEvent {
  id        String   @id // identifiant d'événement Stripe (evt_…)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Code à usage unique envoyé par e-mail (connexion sans mot de passe).
///
/// - `codeHash` : le code n'est JAMAIS stocké en clair (haché comme un mot de passe).
/// - `purpose`  : "verify" (inscription) | "login" (connexion par code) | "reset" (mot de passe oublié).
/// - `payload`  : données en attente pour une inscription non encore vérifiée
///                (JSON : nom, rôle, hash du mot de passe) — l'utilisateur n'est
///                créé qu'une fois le code validé. null pour login/reset.
/// - Un seul code actif à la fois par (email, purpose) : créer un nouveau code
///   invalide les précédents. Expiration courte + nombre de tentatives limité.
model EmailCode {
  id         String    @id @default(cuid())
  email      String // destinataire, toujours en minuscules
  codeHash   String // hachage bcrypt du code (jamais le code en clair)
  purpose    String // "verify" | "login" | "reset"
  payload    String? // JSON optionnel (inscription en attente)
  attempts   Int       @default(0) // saisies erronées (invalidé au-delà du seuil)
  expiresAt  DateTime
  consumedAt DateTime? // non-null = déjà utilisé (ne peut plus servir)
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// Lien parent <-> élève (créé quand le parent saisit le code famille).
model FamilyLink {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     User     @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([childId])
}

/// Encouragement envoyé par un parent (sticker + petit mot).
model Cheer {
  id        String    @id @default(cuid())
  fromId    String
  from      User      @relation("CheerFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User      @relation("CheerTo", fields: [toId], references: [id], onDelete: Cascade)
  sticker   String // emoji
  message   String?
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  @@index([toId, createdAt])
}

/// Défi lancé par un parent, avec une récompense promise.
model Challenge {
  id          String    @id @default(cuid())
  fromId      String
  from        User      @relation("ChallengeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          User      @relation("ChallengeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind        String // "streak" | "reviews" | "mastered" | "focus" | "journal"
  target      Int
  baseline    Int       @default(0) // valeur au lancement (défis cumulatifs)
  reward      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  cancelled   Boolean   @default(false)

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

/// Préférences par utilisateur.
model Settings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Apparence
  theme    String @default("system") // "light" | "dark" | "system"
  locale   String @default("fr")
  font     String @default("serif")  // "serif" | "sans"
  fontSize String @default("base")   // "sm" | "base" | "lg"

  // Habitude / rappels (couche phase 2 — champs prêts)
  reminderEnabled   Boolean @default(false)
  reminderTime      String? // "21:00"
  reminderFrequency String? // "daily" | "weekdays" | "custom"
  streakGoal        Int? // objectif de régularité, en jours/semaine

  // Verrouillage local (phase 3 — champs prêts)
  pinLockEnabled Boolean @default(false)
  pinHash        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une entrée de journal.
model Entry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String?
  content String  @default("") // texte riche léger (Markdown)

  // La date "journal" de l'entrée (jour dont on parle). Par défaut
  // = aujourd'hui, mais peut être antidatée. La timeline et le
  // rappel "il y a un an" s'appuient dessus.
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Humeur (échelle 1-5 + emoji), optionnelle
  mood      Int?
  moodEmoji String?

  // Contexte optionnel
  location String?
  weather  String?

  // Guidage
  promptText String? // le prompt suggéré affiché quand l'entrée a été guidée
  template   String? // "gratitude" | "matin" | "soir" | "5min" ...

  // États
  favorite Boolean @default(false)
  pinned   Boolean @default(false)
  locked   Boolean @default(false) // entrée sensible (verrou spécifique)

  // Trackers optionnels
  energy     Int? // 1-5
  sleepHours Float?
  activities String? // JSON: string[]
  people     String? // JSON: string[]

  tags  Tag[]
  media MediaAttachment[]

  @@index([userId, entryDate])
  @@index([userId, createdAt])
}

/// Tag / catégorie, propre à chaque utilisateur.
model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  entries Entry[]

  @@unique([userId, name])
  @@index([userId])
}

/// Média attaché à une entrée (photos en priorité ; audio/vidéo plus tard).
model MediaAttachment {
  id       String @id @default(cuid())
  entryId  String
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url      String
  type     String // "image" | "audio" | "video"
  width    Int?
  height   Int?
  caption  String?
  createdAt DateTime @default(now())

  @@index([entryId])
}
